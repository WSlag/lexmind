# GasMind AI backend configuration
# Copy to `.env` and fill in values. Default uses `mock` (offline, deterministic).

APP_NAME=GasMind AI
DEBUG=false

# LLM provider: mock | anthropic | openai | ollama | groq | gemini | agnes
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Pipeline tuning
MIN_CONFIDENCE=0.5
MAX_CLAUSES=200
MAX_CONTEXT_CHARS=120000
MAX_REVIEW_TOKENS_PER_CLAUSE=4000

# LLM robustness
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=2

# Batch reviews of multiple clauses per LLM call to reduce latency/cost
CLAUSES_PER_BATCH=5